# ============================================================
# Abarrato · Variables de entorno
# ============================================================
# Instrucciones: Copiar este archivo como .env en la misma carpeta
# y reemplazar los valores de ejemplo por los reales.
# NOTA: El archivo .env real NUNCA debe subirse a GitHub.

# --- Base de datos (OBLIGATORIAS) ---
ABARRATO_DB_URL=jdbc:postgresql://localhost:5432/abarrato
ABARRATO_DB_USER=usuario_ejemplo
ABARRATO_DB_PASSWORD=password_ejemplo

# --- Tarea diaria (Scraping) ---
# Token de al menos 16 caracteres. Si está vacío, la ruta se desactiva.
ABARRATO_TOKEN_TAREA=
ABARRATO_TAREA_MINUTOS=25

# --- Límites de peticiones ---
ABARRATO_LIMITE_POR_CLIENTE=300
ABARRATO_LIMITE_BUSQUEDAS=60
ABARRATO_LIMITE_TOTAL=600

# --- Scraper ---
ABARRATO_SCRAPE_ENABLED=true
ABARRATO_SCRAPE_CRON=0 0 */3 * * *
ABARRATO_PROXY_HOST=
ABARRATO_PROXY_PORT=0
